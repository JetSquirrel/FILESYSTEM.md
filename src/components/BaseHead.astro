---
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";

type Props = SiteMeta;

const { articleDate, dateModified, description, ogImage, title, jsonLdType, faqItems, howToSteps } =
	Astro.props;

const titleSeparator = "•";
const siteTitle = `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage ? ogImage : "/social-card.png", Astro.url).href;

const author = {
	"@type": "Person",
	name: siteConfig.author,
};

const publisher = {
	"@type": "Organization",
	name: siteConfig.title,
	url: siteConfig.url,
};

function buildJsonLd() {
	if (articleDate) {
		return {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			description,
			image: socialImageURL,
			datePublished: articleDate,
			...(dateModified ? { dateModified } : { dateModified: articleDate }),
			author,
			publisher,
			url: canonicalURL.href,
			mainEntityOfPage: {
				"@type": "WebPage",
				"@id": canonicalURL.href,
			},
		};
	}

	const type = jsonLdType ?? (Astro.url.pathname === "/" ? "WebSite" : "WebPage");

	if (type === "WebSite") {
		return {
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: siteConfig.title,
			description: siteConfig.description,
			url: siteConfig.url,
			author,
		};
	}

	if (type === "FAQPage" && faqItems?.length) {
		return {
			"@context": "https://schema.org",
			"@type": "FAQPage",
			name: title,
			description,
			url: canonicalURL.href,
			dateModified,
			author,
			publisher,
			mainEntity: faqItems.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: item.answer,
				},
			})),
		};
	}

	if (type === "HowTo" && howToSteps?.length) {
		return {
			"@context": "https://schema.org",
			"@type": "HowTo",
			name: title,
			description,
			url: canonicalURL.href,
			dateModified,
			author,
			publisher,
			step: howToSteps.map((name, index) => ({
				"@type": "HowToStep",
				position: index + 1,
				name,
			})),
		};
	}

	if (type === "TechArticle") {
		return {
			"@context": "https://schema.org",
			"@type": "TechArticle",
			headline: title,
			description,
			url: canonicalURL.href,
			dateModified,
			author,
			publisher,
			mainEntityOfPage: {
				"@type": "WebPage",
				"@id": canonicalURL.href,
			},
		};
	}

	return {
		"@context": "https://schema.org",
		"@type": "WebPage",
		name: title,
		description,
		url: canonicalURL.href,
		dateModified,
		author,
		publisher,
	};
}

const jsonLd = buildJsonLd();
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>

{/* Icons */}
<link href="/icon.svg" rel="icon" type="image/svg+xml" />
{
	import.meta.env.PROD && (
		<>
			{/* Favicon & Apple Icon */}
			<link rel="icon" href="/favicon-32x32.png" type="image/png" />
			<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
			{/* Manifest */}
			<link href="/manifest.webmanifest" rel="manifest" />
		</>
	)
}

{/* Canonical URL */}
<link href={canonicalURL} rel="canonical" />

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Open Graph / Facebook */}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={siteConfig.ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
<meta content={description} property="og:image:alt" />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
			{(dateModified ?? articleDate) && (
				<meta content={dateModified ?? articleDate} property="article:modified_time" />
			)}
		</>
	)
}

{/* Twitter */}
<meta content="summary_large_image" property="twitter:card" />
<meta content={canonicalURL} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
<meta content={socialImageURL} property="twitter:image" />

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link href="/rss.xml" title="Blog" rel="alternate" type="application/rss+xml" />

<meta content={Astro.generator} name="generator" />

{/* JSON-LD Structured Data */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
