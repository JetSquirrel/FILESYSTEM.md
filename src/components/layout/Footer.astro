---
import { footerLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
	class="mt-auto flex w-full flex-col items-center gap-y-4 border-t border-accent-2/10 pt-10 pb-6 text-center text-sm text-gray-600 sm:flex-row sm:items-start sm:justify-between sm:text-left dark:text-gray-400"
>
	<div class="font-semibold">
		&copy; {siteConfig.author}
		{year}
		<span class="opacity-70"> · {siteConfig.title}</span>
	</div>
	<nav aria-labelledby="footer_links" class="flex max-w-xl flex-wrap justify-center gap-x-4 gap-y-2 sm:justify-end">
		<p id="footer_links" class="sr-only">More on this site</p>
		{
			footerLinks.map((link) => (
				<a class="hover:text-global-text text-sm hover:underline" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
