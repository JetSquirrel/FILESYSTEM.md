---
import { getEntry, render } from "astro:content";
import gettingStartedRaw from "@/content/docs/getting-started.md?raw";
import DocPage from "@/layouts/DocPage.astro";
import { extractHowToSteps } from "@/utils/structured-data";

const doc = await getEntry("docs", "getting-started");

if (!doc) {
	throw new Error("Getting started doc is missing");
}

const { Content } = await render(doc);
const howToSteps = extractHowToSteps(gettingStartedRaw);
---

<DocPage doc={doc} meta={{ jsonLdType: "HowTo", howToSteps }}>
	<Content />
</DocPage>
