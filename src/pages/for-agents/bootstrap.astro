---
import { getEntry, render } from "astro:content";
import bootstrapRaw from "@/content/docs/for-agents-bootstrap.md?raw";
import DocPage from "@/layouts/DocPage.astro";
import { extractHowToSteps } from "@/utils/structured-data";

const doc = await getEntry("docs", "for-agents-bootstrap");

if (!doc) {
	throw new Error("Agent bootstrap doc is missing");
}

const { Content } = await render(doc);
const howToSteps = extractHowToSteps(bootstrapRaw);
---

<DocPage
	doc={doc}
	meta={{
		jsonLdType: howToSteps.length ? "HowTo" : "TechArticle",
		howToSteps: howToSteps.length ? howToSteps : undefined,
	}}
>
	<Content />
</DocPage>
