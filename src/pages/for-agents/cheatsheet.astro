---
import { getEntry, render } from "astro:content";
import DocPage from "@/layouts/DocPage.astro";

const doc = await getEntry("docs", "for-agents-cheatsheet");

if (!doc) {
	throw new Error("Agent cheatsheet doc is missing");
}

const { Content } = await render(doc);
---

<DocPage doc={doc} meta={{ jsonLdType: "TechArticle" }}>
	<Content />
</DocPage>
