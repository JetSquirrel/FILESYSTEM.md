---
import { getEntry, render } from "astro:content";
import DocPage from "@/layouts/DocPage.astro";

const doc = await getEntry("docs", "why-filesystems");

if (!doc) {
	throw new Error("Why filesystems doc is missing");
}

const { Content } = await render(doc);
---

<DocPage doc={doc} meta={{ jsonLdType: "TechArticle" }}>
	<Content />
</DocPage>
