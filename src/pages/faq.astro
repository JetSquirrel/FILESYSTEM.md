---
import { getEntry, render } from "astro:content";
import faqRaw from "@/content/docs/faq.md?raw";
import DocPage from "@/layouts/DocPage.astro";
import { extractFaqItems } from "@/utils/structured-data";

const doc = await getEntry("docs", "faq");

if (!doc) {
	throw new Error("FAQ doc is missing");
}

const { Content } = await render(doc);
const faqItems = extractFaqItems(faqRaw);
---

<DocPage doc={doc} meta={{ jsonLdType: "FAQPage", faqItems }}>
	<Content />
</DocPage>
